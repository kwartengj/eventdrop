# Copy to host/.env for local `npm run dev`.
# Docker Compose overrides hosts so the app container reaches postgres and MinIO.

DATABASE_URL=postgres://eventdrop:eventdrop@localhost:5432/eventdrop

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=eventdrop
S3_ACCESS_KEY=eventdrop
S3_SECRET_KEY=eventdrop-secret

PUBLIC_APP_URL=http://localhost:3000
SESSION_DAYS=30
COOKIE_SECURE=false

# Demo accounts are created by the seed (see README).
